source "https://rubygems.org"

# GitHub Pages environments use the pinned github-pages gem (Jekyll 3.10 + plugins).
gem "github-pages", "~> 232", group: :jekyll_plugins
gem "webrick", "~> 1.8"
# Remote theme support (pair with remote_theme in _config.yml)
gem "jekyll-remote-theme", "~> 0.4"
# Ruby 3.x no longer bundles rexml; kramdown needs it.
gem "rexml", "~> 3.2"